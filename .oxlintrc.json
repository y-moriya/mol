{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": "error",
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["dist", "node_modules", ".wrangler", "drizzle"]
}
