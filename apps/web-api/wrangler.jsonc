{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mol",
  "main": "src/index.tsx",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mol.gunjobiyori.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mol-db",
      "database_id": "2de22175-0902-4042-b90b-c48f49e178d1",
      "migrations_dir": "drizzle"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "mol-posts-index"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
    "POW_HMAC_SECRET": "083d286e41ccd298f560f617c96898d0f92a8929d31d9c9a607dc2d07fb822d8"
  }
}
